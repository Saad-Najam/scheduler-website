# ==============================================================================
# The Quantum Primes — AI Assistant & Web Configuration Example
# Copy this file to .env.local and add your real API keys
# ==============================================================================

# 1. Primary LLM: Google Gemini API (Recommended: gemini-1.5-flash or gemini-2.0-flash)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# 2. Fallback LLM: Groq Cloud API (Used if Gemini fails or quota is exceeded)
# Get your free Groq key at: https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Company Contact Email
CONTACT_RECIPIENT_EMAIL=thequantumprimes@gmail.com

# 4. Optional SMTP Settings (For direct server-side email dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=thequantumprimes@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=thequantumprimes@gmail.com

# 5. Live Scheduler Product URLs (Django backend + React Gantt UI)
NEXT_PUBLIC_SCHEDULER_APP_URL=http://localhost:5173
NEXT_PUBLIC_SCHEDULER_BACKEND_URL=http://localhost:8000
